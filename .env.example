# ================================================================
# APP TEMPLATE - ENVIRONMENT VARIABLES
# ================================================================
# Copy this to .env.local and fill in your secrets
# NEVER commit .env.local to GitHub
#
# Frontend and backend share some variables (SUPABASE_*).
# Backend-only variables are marked [BACKEND].
# ================================================================

# ---- SHARED CONFIGURATION ----

# App name (used for table prefixes, logging, emails)
APP_NAME=xag_webhook_promise_monitor

# Environment (development, staging, production)
NODE_ENV=production

# ---- SUPABASE (Shared "API Verifier LIVE" project) ----
# Go to https://supabase.com/dashboard → Settings → API
# Project URL: https://iwpfhalextbzbvcajtxu.supabase.co (reference)

SUPABASE_URL=https://iwpfhalextbzbvcajtxu.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- BACKEND API ----
# [BACKEND]

# Port backend listens on (local dev)
PORT=3000

# API Admin key (generate: openssl rand -hex 32)
# Used to bypass normal auth for admin tasks
API_ADMIN_KEY=your-secure-random-32-character-hex-key-here

# API Admin PIN (for extra protection)
# Used in addition to API_ADMIN_KEY for sensitive operations
API_ADMIN_PIN=1234

# Allowed origins for CORS (comma-separated)
# Frontend URL (must match where frontend is deployed)
ALLOWED_ORIGINS=http://localhost:5173,https://my-app.vercel.app

# ---- EMAIL ALERTS ----
# [BACKEND]
# Errors and alerts go to this email

ERROR_ALERT_EMAIL=xaglobally@gmail.com

# Email service (sendgrid, mailgun, nodemailer_smtp)
EMAIL_SERVICE=nodemailer_smtp
EMAIL_FROM=alerts@my-app.com

# Nodemailer SMTP (if using nodemailer_smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# OR SendGrid (if using sendgrid)
# SENDGRID_API_KEY=SG.xxxxx...

# OR Mailgun (if using mailgun)
# MAILGUN_API_KEY=key-xxxxx...
# MAILGUN_DOMAIN=mg.my-app.com

# ---- PAYMENT (Optional) ----
# [BACKEND]

# Stripe (for tier-based billing)
STRIPE_SECRET_KEY=sk_live_xxxxx...
STRIPE_WEBHOOK_SECRET=whsec_xxxxx...
STRIPE_PRODUCT_STANDARD=prod_xxxxx...
STRIPE_PRODUCT_PRO=prod_xxxxx...

# OR LemonSqueezy (alternative to Stripe)
# LEMONSQUEEZY_API_KEY=xxxxx...
# LEMONSQUEEZY_STORE_ID=xxxxx...

# ---- LOGGING & MONITORING ----
# [BACKEND]

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Sentry (error tracking, optional)
# SENTRY_DSN=https://xxxxx@o0000.ingest.sentry.io/0000

# ---- DEPLOYMENT ----
# Used by GitHub Actions for auto-deploy
# [BACKEND]

# Vercel (frontend deployment)
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id
VERCEL_TOKEN=vercel_xxxxxxxxxxxxxxxxxxxxxxxx

# Render (backend deployment)
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxx
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxx

# GitHub (for actions, optional)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx

# ---- FEATURE FLAGS (Optional) ----
# [BACKEND]

# Enable debug mode (verbose logging)
DEBUG=false

# Enable maintenance mode (rejects all requests except /health)
MAINTENANCE_MODE=false

# ================================================================
# HOW TO GENERATE SECURE KEYS
# ================================================================
# 
# API_ADMIN_KEY (32-char hex):
#   openssl rand -hex 32
# 
# API_ADMIN_PIN (4-digit):
#   Pick any 4 digits, e.g. 1234
#
# Supabase keys:
#   Get from Supabase dashboard → Settings → API
#   Copy ANON and SERVICE_ROLE keys
#
# Stripe keys:
#   Get from Stripe dashboard → Developers → API keys
#
# Sendgrid:
#   Get from SendGrid dashboard → Settings → API Keys
#
# ================================================================
